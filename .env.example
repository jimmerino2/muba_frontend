# WayFare frontend configuration.
#
# Copy to `.env.local` (gitignored) and fill in. Everything here is compiled
# into the bundle and visible to anyone who opens the page, so NOTHING SECRET
# GOES IN THIS FILE. The Google OAuth *client id* is public by design; the
# client secret, the zkLogin salt secret and the Gonka API key all stay on the
# backend and must never appear here.

# --- Backend ---
# Where muba_backend is serving. Must also be reachable from the browser, and
# this app's own origin must appear in the backend's CORS_ORIGIN list.
VITE_API_BASE_URL=http://localhost:4000

# 'mock' resolves every request from the in-memory fixtures in src/lib/api/mock
# -- the whole lifecycle is walkable with no backend, no database and no Gonka
# key, which is what it is there for. Any other value (including unset) is live.
VITE_API_MODE=live

# --- zkLogin (the default sign-in) ---
# The Google OAuth Client ID from Google Cloud Console (APIs & Services ->
# Credentials -> OAuth client ID -> Web application). This MUST be the same
# client id the backend verifies against (its GOOGLE_CLIENT_ID) -- a mismatch
# makes every login fail with an audience error.
#
# Add this app's origin (e.g. http://localhost:5173) to that OAuth client's
# "Authorised JavaScript origins", or Google refuses to render the prompt.
#
# Leave unset to develop without Google: the login screen then explains that
# zkLogin is unconfigured and offers the backend's seeded demo accounts instead.
VITE_GOOGLE_CLIENT_ID=

# --- Display constants mirrored from the backend ---
# These duplicate backend values the API does not currently expose. Keep them in
# step with the backend's .env, or the UI will explain a decision using a
# threshold the backend did not actually apply.
#
# Backend: TRUTH_SCORE_THRESHOLD
VITE_TRUTH_SCORE_THRESHOLD=80
# Backend: SETTLEMENT_MOCK_MYR_PER_USDC. Display only -- the settled amount
# itself is never converted.
VITE_MYR_PER_USDC=4.7
